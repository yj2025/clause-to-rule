        ]
       },
       {
        "and": [
         {
          "or": [
           {
            "exists": {
             "event": "CARD_USAGE",
             "within": {
              "ref": "$window2"
             }
            }
           },
           {
            "exists": {
             "event": "AUTO_TRANSFER",
             "within": {
              "ref": "$window2"
             }
            }
           }
          ]
         },
         {
          "or": [
           {
            "exists": {
             "event": "SALARY_TRANSFER",
             "within": {
              "ref": "$window2"
