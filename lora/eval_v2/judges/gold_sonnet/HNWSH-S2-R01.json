{
  "clause_id": "HNWSH-S2-R01",
  "label": "가입대상",
  "verdict": "규칙",
  "note": "01 「실명의 개인」→ 법인·임의단체 가입 불가(개인사업자·공동명의는 조문이 말하지 않아 넣지 않음). 02 「1인 1계좌까지만」→ 이미 보유하면 가입 불가.",
  "rules": [
    {
      "rule_id": "HNWSH-S2-R01-01",
      "status": "OK",
      "label": "법인·임의단체는 가입 불가 (실명의 개인만)",
      "source": {
        "quote": "실명의 개인 (1인 1계좌까지만 가능)"
      },
      "condition": {
        "in": [
          {
            "var": "customer.holder_type"
          },
          [
            "CORPORATION",
            "ORGANIZATION"
          ]
        ]
      },
      "effect": {
        "type": "DISQUALIFY"
      }
    },
    {
      "rule_id": "HNWSH-S2-R01-02",
      "status": "OK",
      "label": "이미 이 상품을 보유하면 가입 불가 (1인 1계좌)",
      "source": {
        "quote": "실명의 개인 (1인 1계좌까지만 가능)"
      },
      "condition": {
        "==": [
          {
            "var": "customer.has_product"
          },
          true
        ]
      },
      "effect": {
        "type": "DISQUALIFY"
      }
    }
  ]
}