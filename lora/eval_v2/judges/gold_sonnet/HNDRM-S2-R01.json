{
  "clause_id": "HNDRM-S2-R01",
  "label": "가입대상",
  "verdict": "규칙",
  "note": "01 「만 18세 이하」→ 나이 > 18 이면 DISQUALIFY(경계: 만 18세는 가입 가능). 02 「실명의 개인」→ 법인·임의단체는 가입 불가(개인사업자·공동명의는 조문이 말하지 않아 넣지 않음 — 탈락을 넓히지 않는다). 03 「1인 1계좌」→ 이미 보유하면 가입 불가.",
  "rules": [
    {
      "rule_id": "HNDRM-S2-R01-01",
      "status": "OK",
      "label": "만 18세 초과면 가입 불가",
      "source": {
        "quote": "만 18세 이하 실명의 개인(1인 1계좌)"
      },
      "condition": {
        ">": [
          {
            "var": "customer.age"
          },
          18
        ]
      },
      "effect": {
        "type": "DISQUALIFY"
      }
    },
    {
      "rule_id": "HNDRM-S2-R01-02",
      "status": "OK",
      "label": "법인·임의단체는 가입 불가 (실명의 개인만)",
      "source": {
        "quote": "만 18세 이하 실명의 개인(1인 1계좌)"
      },
      "condition": {
        "in": [
          {
            "var": "customer.holder_type"
          },
          [
            "CORPORATION",
            "ORGANIZATION"
          ]
        ]
      },
      "effect": {
        "type": "DISQUALIFY"
      }
    },
    {
      "rule_id": "HNDRM-S2-R01-03",
      "status": "OK",
      "label": "이미 이 상품을 보유하면 가입 불가 (1인 1계좌)",
      "source": {
        "quote": "만 18세 이하 실명의 개인(1인 1계좌)"
      },
      "condition": {
        "==": [
          {
            "var": "customer.has_product"
          },
          true
        ]
      },
      "effect": {
        "type": "DISQUALIFY"
      }
    }
  ]
}