{
 "clause_id": "HNWSH-S2-R01",
 "label": "가입대상",
 "verdict": "규칙",
 "note": "rule 2개 · 전부 OK. 01 「1인 1계좌까지만 가능」→ has_product 참이면 DISQUALIFY. 02 「실명의 개인」→ 확실히 밖인 법인만 탈락 (kb10 KBGL-S2-R01 관례 · 개인사업자 · 임의단체 · 공동명의는 조문이 말하지 않아 넣지 않았다 — 원칙 1 · 결정 9).",
 "rules": [
  {
   "rule_id": "HNWSH-S2-R01-01",
   "status": "OK",
   "label": "이미 이 상품을 보유하면 가입 불가 (1인 1계좌)",
   "source": {
    "quote": "실명의 개인 (1인 1계좌까지만 가능)"
   },
   "condition": {
    "==": [
     {
      "var": "customer.has_product"
     },
     true
    ]
   },
   "effect": {
    "type": "DISQUALIFY"
   }
  },
  {
   "rule_id": "HNWSH-S2-R01-02",
   "status": "OK",
   "label": "법인은 가입 불가 (실명의 개인)",
   "source": {
    "quote": "실명의 개인 (1인 1계좌까지만 가능)"
   },
   "condition": {
    "in": [
     {
      "var": "customer.holder_type"
     },
     [
      "CORPORATION"
     ]
    ]
   },
   "effect": {
    "type": "DISQUALIFY"
   }
  }
 ]
}